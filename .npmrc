# ═══════════════════════════════════════════════════════════
# SentinelFlow .npmrc — DEVELOPMENT ONLY
#
# This file enforces pnpm for contributors working on the
# SentinelFlow monorepo. It does NOT affect end users who
# install the published npm package via npx/npm/yarn/bun.
#
# The published package has zero runtime dependencies and
# works with any package manager.
# ═══════════════════════════════════════════════════════════

# Enforce engine constraints (prevents npm/yarn from being
# used accidentally in the dev monorepo)
engine-strict=true

# Hoist patterns for better-sqlite3 native addon
shamefully-hoist=true

# Auto-install peers (required for TypeScript + Vitest compat)
auto-install-peers=true
